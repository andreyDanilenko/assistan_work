# Скопируйте в .env и заполните токен нужного подключения.
# Не публикуйте токены и не добавляйте .env в Git.
# Программа читает этот файл сама; source и export не нужны.

GRAFANA_URL=https://grafana.dev.armlab.pro
GRAFANA_DATASOURCE_UID=ddxh9oc39r6rka
GRAFANA_ORG_ID=1
GRAFANA_TOKEN=

LOKI_PROJECT=sds-orders
LOKI_PROJECT_LABEL=app
# Необязательный справочник ID реселлера → название; путь от текущей папки.
RESELLER_MAP_FILE=examples/data.json

# Полный токен бота: цифры, двоеточие и секретная часть.
# telegram-check проверяет бота, telegram-chats помогает найти ID чата.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# watch: каждый цикл читает свежее окно WATCH_INTERVAL, не раньше запуска, без перекрытия.
# Без догрузки пропусков после ошибок, сна или перезапуска, независимо от позиции БД.
# Первый сбор примерно через 2 минуты; сводки заказов раз в 15 минут.
WATCH_INTERVAL=2m
# Ошибочный запрос не повторяется; следующий цикл читает свежее окно.
# Пауза начинается после работы цикла; пропуски сбора видны в отчётах.
# Период предпросмотра --dry-run и окно немедленного анализа, не начальная история.
# В обычном watch анализ ограничен текущим запуском.
WATCH_WINDOW=15m
WATCH_REPORT_INTERVAL=15m
# true: сводка по расписанию; false: дополнительные немедленные уведомления об ошибках.
WATCH_REPORT_ONLY=true
WATCH_COOLDOWN=30m
WATCH_NO_LOGS_AFTER=10m
# Существующее состояние и расписание сохраняются; первая сводка может быть короче 15m.
WATCH_STATE_FILE=local/watch-state.json
# База создается автоматически. Хранение фиксировано: последние 48 часов.
# Сохраненные события и покрытие прошлых запусков остаются доступны для /report.
WATCH_DB_FILE=local/loki.db

# Необязательные фильтры; пустое значение не ограничивает выборку.
# Regex читаются буквально, без shell и подстановок. Пробелы требуют внешних кавычек.
WATCH_INCLUDE_REGEX=
WATCH_EXCLUDE_REGEX=
# Пусто: fatal/critical только в msg/message или текстовом level/severity.
# Свой regex проверяет всю исходную строку и может расширять выборку.
WATCH_CRITICAL_REGEX=
WATCH_ERROR_THRESHOLD=3
